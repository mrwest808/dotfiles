      "$2{const c=Array.from(formData.keys()).reduce((a,k)=>k.length>a?k.length:a,0);console.group('Submit');for(const[k,v]of Array.from(formData.entries())){const l=`${k.padStart(c)}:`;console.log(`%c${l}%c ${v}`,'color: #999; font-weight: bold');}console.groupEnd();}"
